window {
    background-color: transparent;
    border: 0;
    border-radius: 0;
}
mainbox { spacing: 15px; }
inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @outline;
    border-radius: 32px;
}
listview {
    background-color: @surface;
    border: 1px;
    border-color: @outline;
    border-radius: 22px;
}
