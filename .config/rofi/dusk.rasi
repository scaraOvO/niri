* {
    font: "Adwaita Sans 13";
    surface: rgba(38, 30, 51, 0.85);
    foreground: #f4e9f3;
    muted: #d4becf;
    outline: rgba(215, 183, 224, 0.32);
    selection: rgba(232, 185, 164, 0.95);
    selected-text: #382638;
    background-color: transparent;
    text-color: @foreground;
}
@import "launcher-layout.rasi"
