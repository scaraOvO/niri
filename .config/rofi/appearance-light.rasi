* {
    font: "Adwaita Sans 13";
    surface: rgba(255, 247, 237, 0.85);
    foreground: #362b3f;
    muted: #66526c;
    outline: rgba(140, 105, 140, 0.29);
    selection: rgba(242, 205, 183, 0.97);
    selected-text: #4a303b;
    background-color: transparent;
    text-color: @foreground;
}
@import "launcher-layout.rasi"
