#!/bin/sh
center="$HOME/.config/waybar/control-center"
launcher="$HOME/.config/rofi/launch"
selected=$(
    printf '%s\t%s\n' \
        'wallpaper' '壁纸：选择和预览' \
        'alerts' '通知：打开通知中心' \
        'appearance' '主题：配色与透明度设置' \
        'light' '主题：浅色' \
        'dark' '主题：深色' \
        'glass' '主题：高透明' \
        'normal' '场景：日常' \
        'focus' '场景：专注' \
        'presentation' '场景：演示' \
        'windows' '搜索窗口' \
        'displays' '显示器预设' \
        'placement' '窗口：归位设置' |
        DUSK_ROFI_ACTIONS=1 "$launcher" -dmenu -i -no-custom -no-show-icons -display-columns 2 -p ''
) || exit 0
action=$(printf '%s\n' "$selected" | cut -f1)
case "$action" in
    windows|displays) exec python3 -B "$center/desktop_tools.py" "$action" ;;
    wallpaper) exec python3 -B "$center/panel.py" wallpaper ;;
    alerts) exec swaync-client --open-panel ;;
    appearance) exec python3 -B "$center/panel.py" appearance ;;
    light) exec python3 -B "$center/appearance.py" --mode light ;;
    dark) exec python3 -B "$center/appearance.py" --mode dark ;;
    glass) exec python3 -B "$center/appearance.py" --mode glass ;;
    normal) exec python3 -B "$center/scenes.py" normal ;;
    focus) exec python3 -B "$center/scenes.py" focus ;;
    presentation) exec python3 -B "$center/scenes.py" presentation ;;
    placement) exec python3 -B "$center/panel.py" scenes ;;
esac
