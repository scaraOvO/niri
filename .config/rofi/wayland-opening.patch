+/* Animate the mapped launcher by moving its top layer-shell margin. */
+static guint opening_timer;
+static gint64 opening_started;
+static int opening_x_margin, opening_y_margin, opening_offset;
+static gboolean opening_pending, opening_positioned;
+
+static void apply_surface_margin(void) {
+  zwlr_layer_surface_v1_set_margin(wayland->wlr_surface,
+                                   opening_y_margin + opening_offset,
+                                   -opening_x_margin,
+                                   -opening_y_margin - opening_offset,
+                                   opening_x_margin);
+}
+
+static gboolean animate_opening(gpointer data) {
+  double progress = MIN((g_get_monotonic_time() - opening_started) / 270000.0,
+                        1.0);
+  double remaining = 1.0 - progress;
+  int offset = (int)round(-38.0 * remaining * remaining *
+                          (1.0 - 2.5 * progress));
+
+  if (offset != opening_offset) {
+    opening_offset = offset;
+    apply_surface_margin();
+    wl_surface_commit(wayland->surface);
+    wl_display_flush(wayland->display);
+  }
+  if (progress < 1.0) {
+    return G_SOURCE_CONTINUE;
+  }
+  opening_timer = 0;
+  return G_SOURCE_REMOVE;
+}
+
+static struct ext_background_effect_manager_v1 *blur_manager;
+static struct ext_background_effect_surface_v1 *blur_surface;
+static int blur_width, blur_height, blur_scale;
+
+/* Convert the painted launcher silhouette to a surface-local blur region.
+ * Consecutive identical scanlines share one rectangle; empty rows stay clear.
+ */
+static void update_blur_region(cairo_surface_t *surface) {
+  if (blur_manager == NULL ||
+      g_strcmp0(g_getenv("DUSK_ROFI_SPLIT"), "1") != 0) {
+    return;
+  }
+
+  int scale = wayland->scale;
+  int width = cairo_image_surface_get_width(surface) / scale;
+  int height = cairo_image_surface_get_height(surface) / scale;
+  if (blur_surface != NULL && width == blur_width && height == blur_height &&
+      scale == blur_scale) {
+    return;
+  }
+  if (blur_surface == NULL) {
+    blur_surface = ext_background_effect_manager_v1_get_background_effect(
+        blur_manager, wayland->surface);
+  }
+  blur_width = width;
+  blur_height = height;
+  blur_scale = scale;
+
+  struct wl_region *region = wl_compositor_create_region(wayland->compositor);
+  cairo_surface_flush(surface);
+  const unsigned char *pixels = cairo_image_surface_get_data(surface);
+  int stride = cairo_image_surface_get_stride(surface);
+  int run_left = 0, run_right = 0, run_y = 0;
+  for (int y = 0; y <= height; y++) {
+    int left = 0, right = 0;
+    if (y < height) {
+      const uint32_t *row =
+          (const uint32_t *)(pixels + (y * scale + scale / 2) * stride);
+      while (left < width && (row[left * scale + scale / 2] >> 24) == 0) {
+        left++;
+      }
+      right = width;
+      while (right > left &&
+             (row[(right - 1) * scale + scale / 2] >> 24) == 0) {
+        right--;
+      }
+    }
+    if (left == run_left && right == run_right) {
+      continue;
+    }
+    if (run_right > run_left) {
+      wl_region_add(region, run_left, run_y, run_right - run_left, y - run_y);
+    }
+    run_left = left;
+    run_right = right;
+    run_y = y;
+  }
+  ext_background_effect_surface_v1_set_blur_region(blur_surface, region);
+  wl_region_destroy(region);
+}
