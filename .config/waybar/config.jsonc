{
  "layer": "top",
  "position": "top",
  "height": 48,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 7,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "custom/notifications",
    "tray"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "disable-scroll": true,
    "format-icons": {
      "active": "",
      "default": "",
      "urgent": ""
    }
  },
  "niri/window": {
    "format": "{}",
    "max-length": 35,
    "tooltip": false
  },
  "clock": {
    "format": "  {:%H:%M  |  %m/%d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "format-alt": "  {:%Y-%m-%d  %H:%M:%S}"
  },
  "cpu": {
    "format": "  {usage}%"
  },
  "memory": {
    "format": "󰍛  {percentage}%"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format": "{ifname} {ipaddr}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 3,
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 7
  },
  "custom/notifications": {
    "exec": "swaync-client --subscribe-waybar",
    "return-type": "json",
    "format": "{icon} {0}",
    "format-icons": {
      "none": "",
      "notification": "",
      "dnd-none": "",
      "dnd-notification": "",
      "inhibited-none": "",
      "inhibited-notification": "",
      "dnd-inhibited-none": "",
      "dnd-inhibited-notification": ""
    },
    "on-click": "swaync-client --toggle-panel",
    "on-click-right": "swaync-client --toggle-dnd",
    "on-click-middle": "swaync-client --close-all",
    "exec-on-event": false,
    "restart-interval": 3
  }
}
