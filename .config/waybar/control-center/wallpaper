#!/bin/sh
set -eu
config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
image="$config_dir/waybar/control-center/wallpaper.png"
if [ ! -s "$image" ]; then
    image="$config_dir/niri/system-wallpaper.png"
fi
if [ ! -s "$image" ]; then
    image="$config_dir/niri/system-wallpaper.jpg"
fi
if [ ! -s "$image" ]; then
    image="$config_dir/niri/wanderer_coffee.jpg"
fi
if [ "${1:-}" = --print-path ]; then
    printf '%s\n' "$image"
    exit
fi
exec swaybg -i "$image" -m fill
