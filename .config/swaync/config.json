{
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-margin-top": 0,
  "control-center-margin-right": 0,
  "control-center-margin-bottom": 0,
  "control-center-width": 540,
  "control-center-height": 760,
  "notification-window-width": 540,
  "notification-icon-size": 48,
  "timeout": 7,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 270,
  "notification-grouping": true,
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  },
  "layer-shell-cover-screen": false,
  "fit-to-screen": false,
  "control-center-margin-left": 0
}
